# Copia este fichero como .env y rellena los valores reales.
# NUNCA escribas claves reales en este fichero.

# Base de datos
POSTGRES_USER=TU_USUARIO_DB
POSTGRES_PASSWORD=TU_PASSWORD_DB
POSTGRES_DB=herdix_db
DATABASE_URL=postgresql://TU_USUARIO_DB:TU_PASSWORD_DB@localhost:5432/herdix_db

# Seguridad JWT — genera con: openssl rand -hex 32
SECRET_KEY=TU_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq API (gratuito en console.groq.com)
GROQ_API_KEY=TU_CLAVE_GROQ

# Emails con permiso para registrarse (separados por comas)
ALLOWED_EMAILS=tu@email.com

# Entorno
ENVIRONMENT=development
